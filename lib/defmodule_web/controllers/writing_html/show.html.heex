<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl mt-6 sm:mt-0 px-6 lg:px-8">
    <div class="mx-auto max-w-4xl lg:max-w-full">
      <div class="grid grid-cols-8 gap-4 mt-4">
        <div class=" col-span-8 md:col-span-6 overflow-hidden rounded-lg bg-white shadow">
          <div class="px-4 py-5 sm:p-6">
            <!-- Content goes here -->
            <article id={"#{@post.id}"} class="prose prose-code:bg-transparent max-w-full">
              <!-- Title -->
              <h1 class="text-3xl font-semibold text-primary">
                {@post.title}
              </h1>
              <%!-- Author, Data, and Tags --%>
              <div class="flex flex-row gap-x-4 pb-8 flex-wrap md:flex-nowrap">
                <div class="flex flex-row gap-x-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-4 w-4 self-center"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z"
                      clip-rule="evenodd"
                    />
                  </svg>

                  <span class="font-semibold text-neutral">
                    {@post.author}
                  </span>
                </div>
                <div class="flex flex-row gap-x-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-4 w-4 self-center"
                  >
                    <path d="M12.75 12.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM7.5 15.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM8.25 17.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM9.75 15.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM10.5 17.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM12 15.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM12.75 17.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM14.25 15.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM15 17.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM16.5 15.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM15 12.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM16.5 13.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" />
                    <path
                      fill-rule="evenodd"
                      d="M6.75 2.25A.75.75 0 0 1 7.5 3v1.5h9V3A.75.75 0 0 1 18 3v1.5h.75a3 3 0 0 1 3 3v11.25a3 3 0 0 1-3 3H5.25a3 3 0 0 1-3-3V7.5a3 3 0 0 1 3-3H6V3a.75.75 0 0 1 .75-.75Zm13.5 9a1.5 1.5 0 0 0-1.5-1.5H5.25a1.5 1.5 0 0 0-1.5 1.5v7.5a1.5 1.5 0 0 0 1.5 1.5h13.5a1.5 1.5 0 0 0 1.5-1.5v-7.5Z"
                      clip-rule="evenodd"
                    />
                  </svg>

                  <time datetime={"#{@post.date}"} class="text-neutral font-semibold self-center">
                    {Calendar.strftime(@post.date, "%b %d, %Y")}
                  </time>
                </div>
              </div>
              <div class="flex flex-row flex-wrap gap-x-2 mb-4">
                <%!-- Post Tags --%>
                <%= for tag <- @post.tags do %>
                  <a
                    href={"/writing/tags/#{URI.encode_www_form(tag)}"}
                    class="no-underline relative z-10 rounded-full bg-gray-50 p-1.5 text-sm text-neutral hover:bg-slate-300"
                  >
                    {tag}
                  </a>
                <% end %>
              </div>
              <%!-- Divider --%>
              <div class="relative mb-4">
                <div class="absolute inset-0 flex items-center" aria-hidden="true">
                  <div class="w-full border-t border-gray-300"></div>
                </div>
                <div class="relative flex justify-center">
                  <span class="isolate inline-flex -space-x-px rounded-md shadow-sm">
                    <a
                      href={"https://x.com/intent/post?text=&url=#{@current_url}"}
                      type="button"
                      class="inline-flex items-center gap-x-1.5 rounded-l-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 no-underline"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        version="1.1"
                        id="Layer_1"
                        viewBox="0 0 24 24"
                        style="enable-background:new 0 0 24 24;"
                        xml:space="preserve"
                        class="h-4 w-4"
                      >
                        <path d="M14.095479,10.316482L22.286354,1h-1.940718l-7.115352,8.087682L7.551414,1H1l8.589488,12.231093L1,23h1.940717  l7.509372-8.542861L16.448587,23H23L14.095479,10.316482z M11.436522,13.338465l-0.871624-1.218704l-6.924311-9.68815h2.981339  l5.58978,7.82155l0.867949,1.218704l7.26506,10.166271h-2.981339L11.436522,13.338465z" />
                      </svg>
                      <span class="font-semibold text-sm">Share</span>
                    </a>
                    <button
                      type="button"
                      data-copy-url={@current_url}
                      onclick="navigator.clipboard.writeText(this.dataset.copyUrl); this.querySelector('[data-copy-label]').textContent = 'Copied!'; setTimeout(() => this.querySelector('[data-copy-label]').textContent = 'Copy Link', 1500)"
                      class="relative inline-flex items-center rounded-r-md bg-white px-3 text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-10"
                    >
                      <span class="sr-only">Copy Link</span>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="h-4 w-4 mr-2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
                        />
                      </svg>
                      <span class="font-semibold text-small" data-copy-label>Copy Link</span>
                    </button>
                  </span>
                </div>
              </div>

              <%!-- Post Content --%>
              {raw(@post.body)}
            </article>
          </div>
        </div>
        <%!-- Sidebar --%>
        <div class="col-span-8 md:col-span-2 flex flex-col space-y-4 md:inline">
          <%!-- DuckDuckGo site search start--%>
          <div>
            <form method="get" id="ddgsearch" action="https://duckduckgo.com/">
              <div class="relative flex items-center">
                <input type="hidden" name="sites" value="wwwscience.io" />
                <input type="hidden" name="k7" value="#ffffff" />
                <input type="hidden" name="k8" value="#222222" />
                <input type="hidden" name="k9" value="#00278e" />
                <input type="hidden" name="kx" value="#20692b" />
                <input type="hidden" name="kj" value="#fafafa" />
                <input type="hidden" name="kt" value="p" />
                <input
                  type="text"
                  name="q"
                  placeholder="  Search with DuckDuckGo..."
                  id="search"
                  class="block w-full rounded-md border-0 py-1.5 pr-14 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-sky-600 sm:text-sm sm:leading-6"
                />
                <div class="absolute inset-y-0 right-0 flex py-1.5 pr-1.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="h-6 w-6"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                    />
                  </svg>
                </div>
              </div>
            </form>
          </div>
          <%!-- DuckDuckGo site search end --%>
          <%!-- Email Subscription --%>
          <%!-- = live_render(@conn, WwwscienceWeb.EmailSubscriptionLive) --%>
          <div class="flex flex-col space-y-6 border-2 rounded-md shadow max-h-fit p-4">
            <%!-- Follow Us --%>
            <h5 class="text-lg font-bold text-neutral">Follow us</h5>
            <div class="flex flex-row flex-wrap gap-x-2">
              <a
                href="https://x.com/i_ofin"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Follow @i_ofin on X"
                class="relative inline-flex items-center bg-white px-3 py-2 rounded-md text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-10"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                  version="1.1"
                  id="Layer_1"
                  viewBox="0 0 24 24"
                  style="enable-background:new 0 0 24 24;"
                  xml:space="preserve"
                  class="h-5 w-5"
                >
                  <path d="M14.095479,10.316482L22.286354,1h-1.940718l-7.115352,8.087682L7.551414,1H1l8.589488,12.231093L1,23h1.940717  l7.509372-8.542861L16.448587,23H23L14.095479,10.316482z M11.436522,13.338465l-0.871624-1.218704l-6.924311-9.68815h2.981339  l5.58978,7.82155l0.867949,1.218704l7.26506,10.166271h-2.981339L11.436522,13.338465z" />
                </svg>
              </a>
              <a
                href="https://github.com/defmoduledotio"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="defmoduledotio on GitHub"
                class="relative -ml-px inline-flex items-center bg-white px-3 py-2 rounded-md text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-10"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                >
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
              </a>
            </div>
            <%!-- Recent Posts --%>
            <h5 class="text-lg font-bold pt-4 text-neutral">Recent posts</h5>
            <div class="flex flex-col gap-y-2">
              <%= for post <- @recent_posts do %>
                <div>
                  <.link href={"/writing/#{post.id}"}>
                    <h6 class="text-base text-neutral font-medium hover:text-indigo-500">
                      {post.title}
                    </h6>
                  </.link>
                  <p class="text-xs text-slate-600">{post.author} - {post.date}</p>
                </div>
              <% end %>
            </div>
            <%!-- Tags --%>
            <h5 class="text-lg font-bold pt-4 text-neutral">Tags</h5>
            <div class="flex flex-row flex-wrap gap-x-2 gap-y-2">
              <%= for tag <- @tags do %>
                <a
                  href={"/writing/tags/#{URI.encode_www_form(tag)}"}
                  class="bg-gray-200 hover:bg-slate-300 hover:cursor-pointer rounded-lg text-s text-neutral p-1"
                >
                  {tag}
                </a>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
